# Permanent key is read ONLY by the Node server. Never use a VITE_ prefix.
XMAX_API_KEY=
XMAX_ENVIRONMENT=china
XMAX_API_BASE_URL=
# Optional proxy for backend HTTP. Browser WebRTC needs its own working network.
XMAX_PROXY_URL=
# Model warmup budget is capped at 60s; actual input duration + 3s are reserved
# separately for capture/transport. Total lease remains within key expiry - 5s.
# Points are an allowance ceiling, not a claim of actual billed usage.
# Legacy clients without sourceSeconds only; current UI uses the actual input duration (up to 10s).
XMAX_OUTPUT_SECONDS=5
XMAX_SESSION_SECONDS=60
XMAX_POINTS_PER_CASE=100
XMAX_KEY_EXPIRE_SECONDS=90
# Set 1 for unlimited local testing; removes visitor/day and site/day limits.
XMAX_DISABLE_DAILY_LIMITS=0
XMAX_DAILY_POINTS_LIMIT=1000
XMAX_VISITOR_DAILY_LIMIT=5
PORT=5180
# For a public HTTPS deployment, use its exact origin. Empty = localhost and LAN.
PUBLIC_ORIGIN=
# Enable supplied local reference samples only on your private test instance.
ENABLE_LOCAL_DEMO=1

# ---- Camera Studio (toolkits/camera-studio) shares this file; only the port differs ----
# X-Mirror uses PORT, Camera Studio uses CAMERA_STUDIO_PORT.
CAMERA_STUDIO_PORT=5190
# Optional executable paths. Leave blank to use PATH / installed Chrome.
FFMPEG_PATH=
FFPROBE_PATH=
CHROME_PATH=
# Optional Y4M video with a person for explicit real API verification.
STUDIO_TEST_CAMERA_FILE=
# Offline (non-realtime) HD generation. Defaults: model x2.1, quality hd, same gateway as XMAX_API_BASE_URL.
XMAX_OFFLINE_API_BASE_URL=
XMAX_OFFLINE_MODEL=
XMAX_OFFLINE_QUALITY=
# Processing fps sent to the offline API (8/10/12/15/16/18/20/22/24/25/30/45/48/50/60...). Default 30.
XMAX_OFFLINE_FPS=
