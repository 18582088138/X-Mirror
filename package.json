{
  "name": "xmax-x-mirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:live": "node scripts/verify-live.mjs --real-api",
    "prepare:demo": "node scripts/prepare-demo.mjs",
    "toolkit:camera": "npm --prefix toolkits/camera-studio start",
    "toolkit:camera:setup": "npm --prefix toolkits/camera-studio ci && npm --prefix toolkits/camera-studio run prepare:materials",
    "toolkit:camera:test": "npm --prefix toolkits/camera-studio run test:ui"
  },
  "dependencies": {
    "@xmaxai/web-sdk": "1.1.0",
    "cheerio": "1.1.2",
    "fix-webm-duration": "1.0.6",
    "undici": "^7.16.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
